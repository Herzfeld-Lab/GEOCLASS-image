
### MODEL PARAMETERS ###

model:          VarioMLP
num_classes:    10
vario_num_lag:  100
hidden_layers:  [5, 2]
activation:     LeakyReLU

### DATASET PARAMETERS ###

img_path:           /Volumes/rachel_hdd/greenland-enthalpy/data/WV/fridge_1407_rachelmiddleton/ortho-ideal-for-jak
npy_path:           ./Config/greenland_enthalpy/jakobshavn-wv/jakobshavn-ice-stream-2018-2021-10class-reset_52805_(450,600)_split.npy
train_path:         Output/greenland_enthalpy/jakobshavn/test-model-wv/test.npy
valid_path:         Config/greenland_enthalpy/jakobshavn-wv/test.npy
class_enum:         ['Smooth or no visible crevasses', 'Sparse isolated crevasses', 'Thin parallel crevasses', 'Strong parallel crevasses', 'Curved or arcuate crevasses', 'En echelon crevasses', 'Shear-margin oblique crevasses', 'Crosscutting multidirectional crevasses', 'Chaotic heavily fractured crevasses', 'Crevasses obscured by snow or low contrast']
utm_epsg_code:      3413
split_img_size:     [450, 600]
train_test_split:   0.8
train_indices:      None
training_img_path:  Training_data/Greenland/Jakobshavn-wv-2018-2021-10class
training_img_npy:   Config/greenland_enthalpy/jakobshavn-wv/jakobshavn-ice-stream-2018-2021-10class-training.npy
save_all_pred:      True
equal_dataset:      True

### TRAINING PARAMETERS ###

train_with_img: True
use_cuda:       True
num_epochs:     50
fine_epochs:    10
adaptive:       True
alpha:          0.15
beta:           0.85
learning_rate:  5e-5
batch_size:     2
optimizer:      Adam

### DATA AUGMENTATION PARAMETERS ###

directional_vario:  True
random_rotate:      False
random_shift:       False
random_contrast:    False
random_distort:     False

### VISUALIZATION PARAMETERS ###

contour_path:       Config/greenland_enthalpy/jakobshavn-wv/jak-ice-stream.npy
custom_color_map:   None
bg_img_path:        None
bg_UTM_path:        None
        